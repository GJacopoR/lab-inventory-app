.pnp.js

# --- Log di errore (npm, yarn, pnpm) ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Variabili d'Ambiente / Segreti ---
