{
  "name": "lab-inventory-pwa",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pwa": "node scripts/verify-pwa.js",
    "quality": "npm run typecheck && npm run test && npm run verify:pwa",
    "cypress": "cypress open",
    "seed": "node src/seeds/seedOnFirstLaunch.js",
    "deploy": "gh-pages -d dist",
    "predeploy": "npm run build:pages"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3",
    "bcryptjs": "^2",
    "clsx": "^2",
    "dexie": "^4",
    "pdfjs-dist": "^4.4.168",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7",
    "react-router-dom": "^6",
    "tesseract.js": "^4",
    "zod": "^3",
    "zustand": "^4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "cypress": "^13",
    "gh-pages": "^6.3.0",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vite": "^5",
    "vite-plugin-pwa": "^0.19",
    "vitest": "^1"
  }
}
